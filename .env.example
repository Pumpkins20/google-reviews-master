APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SCRAPER_PATH=/full/path/to/google-reviews-scraper-pro (default: storage/scraper/google-reviews-scraper-pro)
SCRAPER_PYTHON=python
SCRAPER_TIMEOUT=3600
SCRAPER_DB=reviews.db

# Yasoga Lab (Node >= 22.12)
YASOGA_NODE=node
YASOGA_TIMEOUT=300
# YASOGA_PATH=storage/scraper/google-maps-review-scraper
# YASOGA_PROXY=


# Queue: scrapes take minutes. Use QUEUE_CONNECTION=database, run "php artisan queue:work --timeout=3700",
# and keep QUEUE_RETRY_AFTER above SCRAPER_TIMEOUT.
# QUEUE_RETRY_AFTER=3800

# Photo classification (Gemini vision) - cost is stored per photo in photo_analyses
# PHOTO_AI_ENABLED=true
# PHOTO_AI_AUTO=true
# PHOTO_AI_MAX_PER_RUN=60
# PHOTO_AI_MODEL=gemini-2.5-flash-lite
# PHOTO_AI_OFFICIAL_HANDLES=
# PHOTO_AI_RPM=12
# PHOTO_AI_COMPANY_PHONES=0878 0816 3003
# PHOTO_AI_NEAR_DISTANCE=2
# PHOTO_AI_NEAR_MIN_DIGITS=9
